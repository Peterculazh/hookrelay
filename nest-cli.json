{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/hookrelay/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/hookrelay/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/hookrelay",
  "projects": {
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "hookrelay": {
      "type": "application",
      "root": "apps/hookrelay",
      "entryFile": "main",
      "sourceRoot": "apps/hookrelay/src",
      "compilerOptions": {
        "tsConfigPath": "apps/hookrelay/tsconfig.app.json"
      }
    },
    "test-receiver": {
      "type": "application",
      "root": "apps/test-receiver",
      "entryFile": "main",
      "sourceRoot": "apps/test-receiver/src",
      "compilerOptions": {
        "tsConfigPath": "apps/test-receiver/tsconfig.app.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    }
  }
}
