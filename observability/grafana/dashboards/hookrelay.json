{
  "uid": "hookrelay-overview",
  "title": "HookRelay — delivery overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "hookrelay"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Scrape health (1 = up, 0 = down)",
      "type": "stat",
      "description": "A down worker makes queue and delivery metrics unavailable. The API still reports the outbox backlog. Collection failures also mark a scrape down.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hookrelay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"hookrelay-.*\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Delivery attempts in selected period",
      "type": "stat",
      "description": "Per receiver request, including retries. Success means the receiver returned 2xx; database finalization errors are logged separately. Increases are scrape-based estimates.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hookrelay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(hookrelay_delivery_attempts_total{service=\"worker\"}[$__range]))",
          "legendFormat": "{{outcome}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "API traffic by route and HTTP status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hookrelay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route, status) (rate(hookrelay_api_requests_total{service=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "API HTTP error rate (4xx / 5xx)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hookrelay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(hookrelay_api_requests_total{service=\"api\",status=~\"4..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(hookrelay_api_requests_total{service=\"api\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "4xx"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(hookrelay_api_requests_total{service=\"api\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(hookrelay_api_requests_total{service=\"api\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "API latency p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hookrelay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(hookrelay_api_request_duration_seconds_bucket{service=\"api\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Receiver response time p95",
      "type": "timeseries",
      "description": "Monotonic duration until response headers or failure, including timeouts. No stored timestamps are used.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hookrelay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(hookrelay_webhook_request_duration_seconds_bucket{service=\"worker\"}[$__rate_interval])))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Delivery attempt rate by outcome",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hookrelay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(hookrelay_delivery_attempts_total{service=\"worker\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Queue jobs by state",
      "type": "timeseries",
      "description": "Point-in-time counts. A stopped worker leaves a gap, not a zero; see scrape health and API outbox backlog.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hookrelay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (hookrelay_queue_jobs{service=\"worker\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Unpublished outbox records",
      "type": "timeseries",
      "description": "Scraped from the API so this remains visible while the worker/publisher is stopped. Max avoids double-counting a shared database across API replicas.",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hookrelay-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hookrelay_outbox_unpublished{service=\"api\"})",
          "legendFormat": "unpublished"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    }
  ]
}
